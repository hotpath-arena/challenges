# perfarena-starter v1 slug=01-log-aggregation language=rust target-cpu=haswell goamd64=v3 hardware-class=my-vps site=https://perfarena.valkirie-shield.xyz
# Local build, check and benchmark with the judge's flags for 01-log-aggregation (rust),
# generated by `perfarena challenge starter-files`. Do not edit it: the judge
# ignores this file, and a stale copy is refused when the Challenge is imported.
#   make build   build with the judge's flags
#   make check   run every sample Test and compare with its .ans
#   make bench   check, then the median of $(RUNS) runs on each public Benchmark Input
# If the binary name is not detected, pass it: make BIN=name

SHELL := bash
STARTER_SLUG := 01-log-aggregation
STARTER_LANGUAGE := rust
SAMPLES := $(abspath ../../data/sample)
BENCH := $(abspath ../../bench)
TMPROOT := $(patsubst %/,%,$(or $(TMPDIR),/tmp))
BUILD := $(TMPROOT)/perfarena-$(STARTER_SLUG)-$(STARTER_LANGUAGE)
CASE_SENSITIVE := yes
SPACE_SENSITIVE := yes
RUNS := 5

NATIVE := $(and $(filter Linux,$(shell uname -s)),$(filter x86_64,$(shell uname -m)))
ifeq ($(NATIVE),)
$(info perfarena: not Linux on x86_64, so the CPU target and static linking are dropped. Correctness matches the judge; times are only comparable between your own runs.)
endif

BIN ?= $(shell sed -n 's/^name *= *"\(.*\)"/\1/p' Cargo.toml | head -1)
ifneq ($(NATIVE),)
RUSTFLAGS_JUDGE := -Ctarget-cpu=haswell -Cforce-frame-pointers=yes -Ctarget-feature=+crt-static
CARGO_TARGET := --target x86_64-unknown-linux-gnu
PROGRAM := $(BUILD)/x86_64-unknown-linux-gnu/release/$(BIN)
else
RUSTFLAGS_JUDGE := -Cforce-frame-pointers=yes
CARGO_TARGET :=
PROGRAM := $(BUILD)/release/$(BIN)
endif

.PHONY: build check bench
build:
	RUSTFLAGS="$(RUSTFLAGS_JUDGE)" cargo build --release --offline --locked $(CARGO_TARGET) --target-dir "$(BUILD)" --bin "$(BIN)"

# Shell helpers, kept on one line so every recipe can include them. run: the
# program on a seekable stdin file in an empty working directory, as the judge
# runs it. same: compare the answer with the program's output as the Challenge's
# validator flags say (case and whitespace), leaving the differences in a file.
FUNCS = \
  norm() { if [ "$(SPACE_SENSITIVE)" = yes ]; then cat "$$1"; else tr -s ' \t\r\n' ' ' < "$$1" | sed 's/^ //; s/ $$//'; fi | if [ "$(CASE_SENSITIVE)" = yes ]; then cat; else tr 'A-Z' 'a-z'; fi; }; \
  same() { diff <(norm "$$1") <(norm "$$2") > "$$3"; }; \
  run() { local d err rc=0; d=$$(mktemp -d); err="$$2.err"; [ "$$2" = /dev/null ] && err=/dev/null; (cd "$$d" && "$(PROGRAM)" < "$$1" > "$$2" 2> "$$err") || rc=$$?; rm -rf -- "$$d"; return $$rc; };

check: build
	@$(FUNCS) fail=0; n=0; shopt -s nullglob; tmp=$$(mktemp); \
	for in in "$(SAMPLES)"/*.in; do name=$$(basename "$$in" .in); n=$$((n+1)); out=$$(mktemp); \
	  if ! run "$$in" "$$out"; then echo "FAIL $$name: the program exited with an error:"; head -5 "$$out.err"; fail=1; \
	  elif [ ! -f "$(SAMPLES)/$$name.ans" ]; then echo "SKIP $$name: no .ans file"; \
	  elif same "$(SAMPLES)/$$name.ans" "$$out" "$$tmp"; then echo "ok   $$name"; \
	  else echo "FAIL $$name: first difference (< expected, > yours):"; sed -n '1,5p' "$$tmp"; fail=1; fi; \
	  rm -f "$$out" "$$out.err"; done; \
	rm -f "$$tmp"; [ $$n -gt 0 ] || { echo "no sample Tests in $(SAMPLES)"; exit 1; }; exit $$fail

bench: check
	@$(FUNCS) shopt -s nullglob; tmp=$$(mktemp); fail=0; \
	for in in "$(BENCH)"/*.in; do name=$$(basename "$$in" .in); out=$$(mktemp); \
	  if ! run "$$in" "$$out"; then echo "FAIL bench $$name: the program exited with an error"; fail=1; rm -f "$$out" "$$out.err"; continue; fi; \
	  if [ -f "$(BENCH)/$$name.ans" ] && ! same "$(BENCH)/$$name.ans" "$$out" "$$tmp"; then echo "FAIL bench $$name: wrong output, first difference (< expected, > yours):"; sed -n '1,5p' "$$tmp"; fail=1; rm -f "$$out" "$$out.err"; continue; fi; \
	  if command -v hyperfine >/dev/null 2>&1; then d=$$(mktemp -d); j=$$(mktemp); (cd "$$d" && hyperfine -N --warmup 1 --runs $(RUNS) --input "$$in" --output null --export-json "$$j" -- "$(PROGRAM)" >/dev/null 2>&1) || true; med=$$(sed -n 's/.*"median": *\([0-9.eE+-]*\).*/\1/p' "$$j" | head -1); rm -rf -- "$$d" "$$j"; tool=hyperfine; \
	  else run "$$in" /dev/null || true; times=""; for i in $$(seq $(RUNS)); do t=$$({ TIMEFORMAT=%R; time run "$$in" /dev/null; } 2>&1); times="$$times $$t"; done; med=$$(printf '%s\n' $$times | sort -n | sed -n "$$(( ($(RUNS)+1)/2 ))p"); tool="shell loop"; fi; \
	  printf 'bench %-16s median %s s over %s runs (%s)\n' "$$name" "$${med:-n/a}" "$(RUNS)" "$$tool"; rm -f "$$out" "$$out.err"; done; \
	rm -f "$$tmp"; exit $$fail
